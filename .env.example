# Copy to .env (make env does this with random secrets).

# Token for the dashboard and API. At least 16 characters.
FLOBASE_API_TOKEN=
FLOBASE_PLATFORM_DB_PASSWORD=

# self-hosted: one organisation, no billing. cloud: plans with prices and cloud regions.
FLOBASE_MODE=self-hosted
# Hostname clients use to reach project databases.
FLOBASE_PUBLIC_HOST=localhost
FLOBASE_PORT=8080
# Public URL of the API gateway that client SDKs call.
FLOBASE_GATEWAY_URL=http://localhost:8000
FLOBASE_GATEWAY_PORT=8000
# Price = estimated cloud cost × this.
FLOBASE_MARKUP=1.6

# Off-site backup copies to S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, Wasabi, MinIO). Leave the bucket empty to keep backups on
# this machine only.
FLOBASE_BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
FLOBASE_BACKUP_S3_REGION=us-east-1
FLOBASE_BACKUP_S3_BUCKET=
FLOBASE_BACKUP_S3_PREFIX=flobase
FLOBASE_BACKUP_S3_ACCESS_KEY=
FLOBASE_BACKUP_S3_SECRET_KEY=
# Encrypts copies before they leave this machine. Keep it somewhere safe:
# without it the copies cannot be restored.
FLOBASE_BACKUP_ENCRYPTION_KEY=
