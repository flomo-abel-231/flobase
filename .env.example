# FloBase settings. scripts/install.sh writes .env from this file with new
# secrets; for development, `make env` does the same.

# Release to run (install.sh and upgrade.sh set this).
FLOBASE_VERSION=
# Install new releases automatically: true or false.
FLOBASE_AUTO_UPDATE=false
# Where install.sh (or FloBase Desktop and the flobase CLI) put FloBase on
# the host; needed for self-updates.
FLOBASE_INSTALL_DIR=
FLOBASE_UPDATE_REPO=flomo-abel-231/flobase


# Token for the dashboard and API. At least 16 characters.
FLOBASE_API_TOKEN=
FLOBASE_PLATFORM_DB_PASSWORD=

# self-hosted: one organisation, no billing. cloud: plans with prices and cloud regions.
FLOBASE_MODE=self-hosted
# Hostname clients use to reach project databases.
FLOBASE_PUBLIC_HOST=localhost
# Host ports for the dashboard and the project APIs. Uncommon on purpose:
# 8080, 8000, 3000 and the like are usually taken by other development tools.
FLOBASE_PORT=28470
# Public URL of the API gateway that client SDKs call.
FLOBASE_GATEWAY_URL=http://localhost:28471
FLOBASE_GATEWAY_PORT=28471
# Price = estimated cloud cost × this.
FLOBASE_MARKUP=1.6
# Cloud mode: the sign-up with this address becomes the platform owner, who
# manages regions, backup storage and updates. Empty = the first account.
FLOBASE_OWNER_EMAIL=

# Off-site backup copies to S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, Wasabi, MinIO). Leave the bucket empty to keep backups on
# this machine only.
FLOBASE_BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
FLOBASE_BACKUP_S3_REGION=us-east-1
FLOBASE_BACKUP_S3_BUCKET=
FLOBASE_BACKUP_S3_PREFIX=flobase
FLOBASE_BACKUP_S3_ACCESS_KEY=
FLOBASE_BACKUP_S3_SECRET_KEY=
# Encrypts copies before they leave this machine. Keep it somewhere safe:
# without it the copies cannot be restored.
FLOBASE_BACKUP_ENCRYPTION_KEY=
